# OpenAI API Configuration (Required)
OPENAI_API_KEY=sk-...

# WordPress Configuration
# URL of your WordPress website (without trailing slash)
WORDPRESS_URL=https://tradingblogco.com

# WordPress Admin Username
WORDPRESS_USERNAME=admin

# WordPress Application Password (Generate in WP Admin -> Users -> Profile -> Application Passwords)
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Default Status: 'publish' or 'draft'
WORDPRESS_DEFAULT_STATUS=publish
